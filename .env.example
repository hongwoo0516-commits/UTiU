# Copy to .env.local and supply your MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
# A separate database keeps UTiU data away from your study project.
MONGODB_DB_NAME=utiu
# Generate a fresh secret with npm run env:setup.
AUTH_SECRET=
# Local self-hosting: change AUTH_URL to your actual address when deploying.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
